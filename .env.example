# Copy to .env and fill in. Keys stay on this machine; never commit .env.

# LLM order: the first is tried, then each fallback in turn (comma list).
# Options: groq, groq_backup, groq_background, ollama (laptop qwen3:4b takes ~50 s per reply on CPU, so it is only in the background order)
COMPANION_BACKGROUND_LLM=groq_background,groq_backup,groq,ollama
COMPANION_LLM=groq
COMPANION_LLM_FALLBACK=groq_backup
GROQ_API_KEY=
COMPANION_GROQ_MODEL=openai/gpt-oss-120b
COMPANION_GROQ_BACKUP_MODEL=qwen/qwen3.8-27b
# Memory extraction and summaries (each Groq model has its own free-tier quota of 8000 tokens/minute)
COMPANION_GROQ_BACKGROUND_MODEL=openai/gpt-oss-20b
COMPANION_OLLAMA_URL=http://127.0.0.1:11434
COMPANION_OLLAMA_MODEL=qwen3:4b

# Postgres. The tables live in their own schema, so a shared database is fine.
COMPANION_DATABASE_URL=postgresql://bs@/synq?host=/var/run/postgresql
COMPANION_DB_SCHEMA=companion

# Memory adapter: postgres | in_memory
COMPANION_MEMORY=postgres

# Web search (Tavily). Leave empty to turn the web_search tool off.
TAVILY_API_KEY=

# Voice. STT: groq (cloud Whisper, fast; audio goes to Groq) | whisper (laptop) | sarvam (cloud).
# TTS: piper (laptop) | sarvam (cloud).
COMPANION_STT=groq
COMPANION_STT_FALLBACK=whisper,sarvam
COMPANION_GROQ_STT_MODEL=whisper-large-v3-turbo
COMPANION_TTS=piper
COMPANION_TTS_FALLBACK=sarvam
# Whisper size: tiny | base | small (small hears Hinglish better but is slower on CPU)
COMPANION_WHISPER_MODEL=base
# Empty = detect Hindi or English per clip
COMPANION_WHISPER_LANGUAGE=
COMPANION_PIPER_VOICE=models/en_US-amy-medium.onnx
COMPANION_TTS_SPEED=1.0
# Sarvam (Indian voices, good for Hinglish). Leave empty to skip it.
SARVAM_API_KEY=
COMPANION_SARVAM_STT_MODEL=saarika:v2.5
COMPANION_SARVAM_TTS_MODEL=bulbul:v2
COMPANION_SARVAM_SPEAKER=anushka
COMPANION_SARVAM_LANGUAGE=hi-IN

# Front-end plugins (comma list; folders in companion/server/plugins). Empty = none.
COMPANION_UI_PLUGINS=robot
# Browser pages on other addresses that may call this server (the umbrella-d dashboard). Empty = none.
COMPANION_CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

COMPANION_NAME=Umbrella
COMPANION_TIMEZONE=Asia/Kolkata

# Live voice over LiveKit (WebRTC). Keys stay on this machine.
COMPANION_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Seconds of quiet after Umbrella speaks before one gentle follow-up
COMPANION_SILENCE_NUDGE_SECONDS=10
COMPANION_LIVE_MAX_MINUTES=30
